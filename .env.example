# Strapi backend (auto-filled on first `npm run dev:strapi`)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# E-mail via Resend (optioneel — zonder dit opent de knop de mail-app)
# 1. Maak account op https://resend.com
# 2. Kopieer API key
# 3. Verifieer domein of gebruik onboarding@resend.dev voor tests
RESEND_API_KEY=
RESEND_FROM_EMAIL=GO BIKE <onboarding@resend.dev>
RESEND_REPLY_TO=info@gobike.be
